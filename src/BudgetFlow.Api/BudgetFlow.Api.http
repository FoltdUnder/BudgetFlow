@host = http://localhost:8080
@accessToken = paste-access-token
@refreshToken = paste-refresh-token

### Register
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "Email": "somehelp22@gmail.com",
  "FullName": "Jora Pop",
  "Password": "7878"
}

###


### Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "Email": "somehelp22@gmail.com",
  "Password": "7878"
}

###


### Refresh
POST {{host}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
###

### test me
GET {{host}}/api/test/me
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Create wallet
POST {{host}}/api/wallets
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "name": "Main wallet",
  "currency": "USD",
  "initialBalance": 100.00
}

###

### List own wallets
GET {{host}}/api/wallets
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### List own transactions
GET {{host}}/api/transactions
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Filter transactions by wallet
GET {{host}}/api/transactions?walletId=00000000-0000-0000-0000-000000000001
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Filter transactions by type, category, and date range
GET {{host}}/api/transactions?type=Expense&categoryId=00000000-0000-0000-0000-000000000002&from=2026-03-01&to=2026-03-31
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### User dashboard
GET {{host}}/api/dashboard
Accept: application/json
Authorization: Bearer {{accessToken}}

###
